# Copy this file to .env and fill in ONE key.
LLM_PROVIDER=gemini            # gemini | openai
# Gemini model names get retired; if the chat gets no reply, check the current names at ai.google.dev
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=your-gemini-key
# OPENAI_API_KEY=your-openai-key

# Embeddings for RAG: local (offline, keyword-based) | gemini | openai
EMBEDDINGS_PROVIDER=local

# single = one agent with all tools | multi = supervisor routes to info and booking specialists
AGENT_MODE=single
